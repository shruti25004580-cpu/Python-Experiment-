#Bitwise Operator
print("\nBitwise Operation:\n")
a=10
b=4
print("A=10\nB=4\n")
print("a & b =",a&b)
print("a | b =",a|b)
print("a ^ b =",a^b)
print("~a =",~a)
print("a << b =",a<<b)
print("a >> b =",a>>b)

#Identity Operator

print("\nIdentity operation:\n")
a=4
