#STRING OPERATIONS

s = "My Name Is Shruti "
print("Original String",s)

#Find length
print("Length of string is", len(s))

#Convert uppercase
print("Uppercase:",s.upper())

#Convert lowercase
print("Lowercase:",s.lower())

#Get char at a position
print("Character at index 6:",s[6])

#Find position of a word
print("Position of Shruti:",s.find("Shruti"))

#Extract part of a string
print("Slice:",s[6:13])

#Replace a word
print("Replace:",s.replace("Shruti","Celific"))

#Check whether a word exists
print("Contains Name:","Name" in s)

#Concatenate two strings
print("Concatination:",s + " Manjunath")

#Stripping
s2 = "   Hello  World   "
print("Strip:",s2.strip())
